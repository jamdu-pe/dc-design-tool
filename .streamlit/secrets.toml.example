# 자격증명 템플릿 — 이 파일을 `secrets.toml` 로 복사해서 값을 채운다.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# `.streamlit/secrets.toml` 은 .gitignore 에 걸려 있다. 절대 커밋하지 말 것.
# Streamlit Community Cloud 에서는 파일을 올리지 않고 앱 설정의
# Settings → Secrets 에 이 내용을 그대로 붙여 넣는다(README 배포 절차 참고).
#
# 비밀번호는 평문이 아니라 bcrypt 해시를 넣는다. 해시 생성:
#
#   python scripts/hash_password.py
#
# (비밀번호를 인자로 받지 않고 입력을 가린다 — 셸 히스토리에 남지 않는다.)

[auth.cookie]
# 브라우저 쿠키 이름. 같은 도메인에 여러 앱을 올릴 때만 바꾸면 된다.
name = "dc_design_auth"
# 쿠키 서명 키. 반드시 길고 무작위한 값으로 교체할 것.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
key = "여기에-무작위-문자열-48자-이상"
# 재로그인 없이 유지되는 기간(일). 사내 공유 용도면 1일 정도가 무난하다.
expiry_days = 1

# ---------------------------------------------------------------------------
# 사용자 목록. 테이블 이름의 마지막 조각이 로그인 ID(사번)다.
# 사번은 숫자로 시작하므로 반드시 따옴표로 감쌀 것: usernames."20240101"
# 사용자를 추가하려면 아래 블록을 복사해 사번만 바꾸면 된다.
# ---------------------------------------------------------------------------

[auth.credentials.usernames."20240101"]
name = "홍길동"                     # 화면에 표시할 이름
email = "hong@example.com"          # 라이브러리 요구 필드. 실제로 메일을 보내지는 않는다
password = "$2b$12$여기에-bcrypt-해시-붙여넣기"

[auth.credentials.usernames."20240102"]
name = "김철수"
email = "kim@example.com"
password = "$2b$12$여기에-bcrypt-해시-붙여넣기"
